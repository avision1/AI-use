[Desktop Entry]
Type=Application
Name=Excel (web)
Comment=Official Microsoft web service; requires internet and an eligible account
Exec=/usr/local/bin/windows12-webapp excel
TryExec=/usr/local/bin/windows12-webapp
Icon=x-office-spreadsheet
Terminal=false
Categories=Office;Network;
StartupNotify=true
StartupWMClass=windows12-excel
